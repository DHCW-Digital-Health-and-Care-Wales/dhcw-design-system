{%- from "fieldset/macro.njk" import nhswFieldset -%}
{%- from "hint/macro.njk" import nhswHint -%}
{%- from "error-message/macro.njk" import nhswErrorMessage -%}

{#
  nhswCheckboxes(params) - a group of checkboxes, wrapped in a fieldset.

  params:
    fieldset       object   - { legend: { text, html, classes } }
    hint           object   - { text, html, classes, attributes } - group hint
    errorMessage   object   - { text, html, visuallyHiddenText, classes, attributes }
    classes        string   - extra classes on the .nhsw-checkboxes container,
                               e.g. "nhsw-checkboxes--small", "nhsw-checkboxes--inline"
    attributes     object   - extra HTML attributes on the .nhsw-checkboxes container
    name           string   (required) - shared name for all checkbox items
    idPrefix       string   - defaults to name; base for auto-generated item ids ({idPrefix}-{n})
    items          array    - [{ text, html, value, id, checked, disabled,
                                 hint: { text, html },
                                 conditional: { html, text },
                                 divider, behaviour }]
                               a { divider: "or" } item renders a divider instead of a checkbox.
                               behaviour: "exclusive" adds data-checkbox-exclusive to that item's input
                               (used for "none of these"-style options).
#}
{%- macro nhswCheckboxes(params) -%}
{%- set idPrefix = params.idPrefix or params.name -%}
{%- set hintId = idPrefix + "-hint" -%}
{%- set errorId = idPrefix + "-error" -%}
{%- set describedByParts = [] -%}
{%- if params.hint %}{% set describedByParts = describedByParts.concat([hintId]) %}{% endif -%}
{%- if params.errorMessage %}{% set describedByParts = describedByParts.concat([errorId]) %}{% endif -%}
{%- set describedBy = describedByParts | join(" ") -%}
{%- set itemCount = 0 -%}
<div class="nhsw-form-group{% if params.errorMessage %} nhsw-form-group--error{% endif %}">
{%- call nhswFieldset({ legend: params.fieldset.legend if params.fieldset else none, describedBy: describedBy }) %}
{%- if params.hint %}
  {{ nhswHint({ text: params.hint.text, html: params.hint.html, id: hintId, classes: params.hint.classes, attributes: params.hint.attributes }) }}
{%- endif %}
{%- if params.errorMessage %}
  {{ nhswErrorMessage({ text: params.errorMessage.text, html: params.errorMessage.html, id: errorId, visuallyHiddenText: params.errorMessage.visuallyHiddenText, classes: params.errorMessage.classes, attributes: params.errorMessage.attributes }) }}
{%- endif %}
  <div class="nhsw-checkboxes{% if params.classes %} {{ params.classes }}{% endif %}"{% for attrName, attrValue in (params.attributes or {}) %} {{ attrName }}="{{ attrValue }}"{% endfor %}>
{%- for item in (params.items or []) %}
{%- if item.divider %}
    <div class="nhsw-checkboxes__divider">{{ item.divider }}</div>
{%- else %}
{%- set itemCount = itemCount + 1 %}
{%- set itemId = item.id or (idPrefix + "-" + itemCount|string) %}
{%- set itemHintId = itemId + "-hint" %}
{%- set conditionalId = "conditional-" + itemId %}
    <div class="nhsw-checkboxes__item">
      <input class="nhsw-checkboxes__input" id="{{ itemId }}" name="{{ params.name }}" type="checkbox"{% if item.value %} value="{{ item.value }}"{% endif %}{% if item.checked %} checked{% endif %}{% if item.disabled %} disabled{% endif %}{% if item.hint %} aria-describedby="{{ itemHintId }}"{% endif %}{% if params.errorMessage %} aria-invalid="true"{% endif %}{% if item.conditional %} data-aria-controls="{{ conditionalId }}"{% endif %}{% if item.behaviour == "exclusive" %} data-checkbox-exclusive{% endif %}>
      <label class="nhsw-label nhsw-checkboxes__label" for="{{ itemId }}">{{ item.html | safe if item.html else item.text }}</label>
{%- if item.hint %}
      <div class="nhsw-hint nhsw-checkboxes__hint" id="{{ itemHintId }}">{{ item.hint.html | safe if item.hint.html else item.hint.text }}</div>
{%- endif %}
    </div>
{%- if item.conditional %}
    <div class="nhsw-checkboxes__conditional" id="{{ conditionalId }}" aria-live="polite">{{ item.conditional.html | safe if item.conditional.html else item.conditional.text }}</div>
{%- endif %}
{%- endif %}
{%- endfor %}
  </div>
{%- endcall %}
</div>
{%- endmacro -%}

{#
  Convenience import — pulls every nhsw* macro into scope in one line:

    {% import "all-components.njk" as nhsw %}
    {{ nhsw.nhswButton({ text: "Continue", classes: "nhsw-button--primary" }) }}

  Individual components can also be imported directly for a smaller
  dependency footprint, e.g. {% from "button/macro.njk" import nhswButton %}.

  (Each macro is re-bound with {% set %} after its {% from %} import because
  Nunjucks does not transitively re-export from-imported names through a
  subsequent {% import %} — only a template's own top-level macros/sets are.)
#}


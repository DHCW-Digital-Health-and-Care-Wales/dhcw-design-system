{#
  nhswPagination(params)

  Two visual variants:
    - variant: "numbered" - numbered page links with previous/next arrows and
      optional ellipses.
    - variant unset - previous/next content pagination, showing the adjacent
      page's title.

  params:
    variant     string  - "numbered", or unset for the content previous/next variant
    previous    object  - numbered: { href }. content: { href, title, label }
                           (title defaults to "Previous", label is the page name).
                           Omitted entirely if not given (e.g. first page).
    next        object  - numbered: { href }. content: { href, title, label }
                           (title defaults to "Next", label is the page name).
                           Omitted entirely if not given (e.g. last page).
    items       array   - numbered variant only. List of either
                           { number, href, current } or { ellipsis: true }.
    ariaLabel   string  - defaults to "Pagination"
    classes     string  - extra classes
    attributes  object  - extra HTML attributes
#}
{%- macro nhswPagination(params) -%}
{%- set ariaLabel = params.ariaLabel or "Pagination" -%}
{%- if params.variant == "numbered" -%}
<nav class="nhsw-pagination nhsw-pagination--numbered{% if params.classes %} {{ params.classes }}{% endif %}" role="navigation" aria-label="{{ ariaLabel }}"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}>
{%- if params.previous %}
  <a href="{{ params.previous.href }}" class="nhsw-pagination__previous" rel="prev">
    <svg class="nhsw-pagination__icon" viewBox="0 0 17 15" focusable="false" aria-hidden="true"><path d="M0.292893 6.65666C-0.0976314 7.04719 -0.0976315 7.68035 0.292892 8.07087L6.65685 14.4348C7.04738 14.8254 7.68054 14.8254 8.07107 14.4348C8.46159 14.0443 8.46159 13.4111 8.07107 13.0206L2.41421 7.36377L8.07107 1.70691C8.46159 1.31639 8.46159 0.683225 8.07107 0.292701C7.68054 -0.0978235 7.04738 -0.0978235 6.65686 0.292701L0.292893 6.65666ZM17 7.36377L17 6.36377L1 6.36377L1 7.36377L1 8.36377L17 8.36377L17 7.36377Z" /></svg>
    <span class="nhsw-pagination__title">Previous</span>
  </a>
{%- endif %}
  <ul class="nhsw-pagination__list">
{%- for item in (params.items or []) %}
{%- if item.ellipsis %}
    <li class="nhsw-pagination__item nhsw-pagination__item--ellipsis">&ctdot;</li>
{%- else %}
    <li class="nhsw-pagination__item{% if item.current %} nhsw-pagination__item--current{% endif %}"><a class="nhsw-pagination__number-link" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %} aria-label="Page {{ item.number }}">{{ item.number }}</a></li>
{%- endif %}
{%- endfor %}
  </ul>
{%- if params.next %}
  <a href="{{ params.next.href }}" class="nhsw-pagination__next" rel="next">
    <span class="nhsw-pagination__title">Next</span>
    <svg class="nhsw-pagination__icon" viewBox="0 0 17 15" focusable="false" aria-hidden="true"><path d="M16.7071 8.07088C17.0976 7.68035 17.0976 7.04719 16.7071 6.65666L10.3431 0.292703C9.95262 -0.0978218 9.31946 -0.0978219 8.92893 0.292703C8.53841 0.683227 8.53841 1.31639 8.92893 1.70692L14.5858 7.36377L8.92893 13.0206C8.53841 13.4111 8.53841 14.0443 8.92893 14.4348C9.31946 14.8254 9.95262 14.8254 10.3431 14.4348L16.7071 8.07088ZM0 7.36377L-8.74224e-08 8.36377L16 8.36377L16 7.36377L16 6.36377L8.74224e-08 6.36377L0 7.36377Z" /></svg>
  </a>
{%- endif %}
</nav>
{%- else -%}
<nav class="nhsw-pagination{% if params.classes %} {{ params.classes }}{% endif %}" role="navigation" aria-label="{{ ariaLabel }}"{% for name, value in (params.attributes or {}) %} {{ name }}="{{ value }}"{% endfor %}>
  <ul class="nhsw-pagination__list">
{%- if params.previous %}
    <li class="nhsw-pagination-item--previous">
      <a class="nhsw-pagination__link" href="{{ params.previous.href }}">
        <svg class="nhsw-icon" viewBox="0 0 17 15" focusable="false" aria-hidden="true"><path d="M0.292893 6.65666C-0.0976314 7.04719 -0.0976315 7.68035 0.292892 8.07087L6.65685 14.4348C7.04738 14.8254 7.68054 14.8254 8.07107 14.4348C8.46159 14.0443 8.46159 13.4111 8.07107 13.0206L2.41421 7.36377L8.07107 1.70691C8.46159 1.31639 8.46159 0.683225 8.07107 0.292701C7.68054 -0.0978235 7.04738 -0.0978235 6.65686 0.292701L0.292893 6.65666ZM17 7.36377L17 6.36377L1 6.36377L1 7.36377L1 8.36377L17 8.36377L17 7.36377Z" /></svg>
        <span class="nhsw-pagination__title">{{ params.previous.title or "Previous" }}</span>
{%- if params.previous.label %}
        <span class="nhsw-pagination__page">{{ params.previous.label }}</span>
{%- endif %}
      </a>
    </li>
{%- endif %}
{%- if params.next %}
    <li class="nhsw-pagination-item--next">
      <a class="nhsw-pagination__link" href="{{ params.next.href }}">
        <span class="nhsw-pagination__title">{{ params.next.title or "Next" }}</span>
{%- if params.next.label %}
        <span class="nhsw-pagination__page">{{ params.next.label }}</span>
{%- endif %}
        <svg class="nhsw-icon" viewBox="0 0 17 15" focusable="false" aria-hidden="true"><path d="M16.7071 8.07088C17.0976 7.68035 17.0976 7.04719 16.7071 6.65666L10.3431 0.292703C9.95262 -0.0978218 9.31946 -0.0978219 8.92893 0.292703C8.53841 0.683227 8.53841 1.31639 8.92893 1.70692L14.5858 7.36377L8.92893 13.0206C8.53841 13.4111 8.53841 14.0443 8.92893 14.4348C9.31946 14.8254 9.95262 14.8254 10.3431 14.4348L16.7071 8.07088ZM0 7.36377L-8.74224e-08 8.36377L16 8.36377L16 7.36377L16 6.36377L8.74224e-08 6.36377L0 7.36377Z" /></svg>
      </a>
    </li>
{%- endif %}
  </ul>
</nav>
{%- endif -%}
{%- endmacro -%}

{%- from "label/macro.njk" import nhswLabel -%}
{%- from "hint/macro.njk" import nhswHint -%}
{%- from "error-message/macro.njk" import nhswErrorMessage -%}

{#
  nhswInput(params) - a single-line text input, with prefix/suffix and
  character-count support.

  params:
    id              string   (required) - id and default name of the input
    name            string   - defaults to id
    type            string   - defaults to "text" (email, tel, number, search, password, ...)
    value           string   - initial value
    label           object   - { text, html, classes, isPageHeading, attributes }
    hint            object   - { text, html, classes, attributes }
    errorMessage    object   - { text, html, visuallyHiddenText, classes, attributes }
    classes         string   - extra classes on the <input>, e.g. width modifiers:
                               nhsw-input--full/--three-quarters/--two-thirds/--half/--third/--quarter
                               nhsw-input--width-2/-3/-4/-5/-10/-20
    attributes      object   - extra HTML attributes on the <input>
    inputmode       string   - e.g. "numeric", "decimal"
    autocomplete    string   - e.g. "bday-day"
    spellcheck      bool     - adds spellcheck="true"/"false"
    pattern         string   - validation pattern
    maxlength       integer  - adds maxlength; also enables the character-count hint unless
                               characterCount is explicitly false
    characterCount  bool     - set false to add maxlength without the character-count hint
    characterCountMessage  string - override the initial count text, "You have N characters
                               remaining". It is what assistive technology reads when the
                               field is focused. nhsw-behaviours.js hides it visually, keeps its
                               text current, and adds a visible count and a polite live region
                               beside it
    disabled        bool
    readonly        bool
    prefix          object   - { text, html } - rendered before the input (nhsw-input-wrapper)
    suffix          object   - { text, html } - rendered after the input (nhsw-input-wrapper)
    formGroup       object   - { classes } - extra classes on the wrapping nhsw-form-group
#}
{%- macro nhswInput(params) -%}
{%- set name = params.name or params.id -%}
{%- set hintId = params.id + "-hint" -%}
{%- set errorId = params.id + "-error" -%}
{%- set hasCharacterCount = params.maxlength and params.characterCount != false -%}
{%- set countId = params.id + "-count" -%}
{%- set describedByParts = [] -%}
{%- if params.hint %}{% set describedByParts = describedByParts.concat([hintId]) %}{% endif -%}
{%- if params.errorMessage %}{% set describedByParts = describedByParts.concat([errorId]) %}{% endif -%}
{%- if hasCharacterCount %}{% set describedByParts = describedByParts.concat([countId]) %}{% endif -%}
{%- set describedBy = describedByParts | join(" ") -%}
<div class="nhsw-form-group{% if params.errorMessage %} nhsw-form-group--error{% endif %}{% if params.formGroup and params.formGroup.classes %} {{ params.formGroup.classes }}{% endif %}">
{%- if params.label %}
  {{ nhswLabel({ text: params.label.text, html: params.label.html, for: params.id, classes: params.label.classes, isPageHeading: params.label.isPageHeading, attributes: params.label.attributes }) }}
{%- endif %}
{%- if params.hint %}
  {{ nhswHint({ text: params.hint.text, html: params.hint.html, id: hintId, classes: params.hint.classes, attributes: params.hint.attributes }) }}
{%- endif %}
{%- if params.errorMessage %}
  {{ nhswErrorMessage({ text: params.errorMessage.text, html: params.errorMessage.html, id: errorId, visuallyHiddenText: params.errorMessage.visuallyHiddenText, classes: params.errorMessage.classes, attributes: params.errorMessage.attributes }) }}
{%- endif %}
{%- set inputEl -%}
<input class="nhsw-input{% if params.errorMessage %} nhsw-is-invalid{% endif %}{% if params.classes %} {{ params.classes }}{% endif %}" id="{{ params.id }}" name="{{ name }}" type="{{ params.type or 'text' }}"{% if params.value %} value="{{ params.value }}"{% endif %}{% if describedBy %} aria-describedby="{{ describedBy }}"{% endif %}{% if params.errorMessage %} aria-invalid="true"{% endif %}{% if params.inputmode %} inputmode="{{ params.inputmode }}"{% endif %}{% if params.autocomplete %} autocomplete="{{ params.autocomplete }}"{% endif %}{% if params.spellcheck != undefined %} spellcheck="{{ params.spellcheck }}"{% endif %}{% if params.pattern %} pattern="{{ params.pattern }}"{% endif %}{% if params.maxlength %} maxlength="{{ params.maxlength }}"{% endif %}{% if hasCharacterCount %} data-max-length="{{ params.maxlength }}" data-max-length-target="{{ countId }}"{% endif %}{% if params.disabled %} disabled{% endif %}{% if params.readonly %} readonly{% endif %}{% for attrName, attrValue in (params.attributes or {}) %} {{ attrName }}="{{ attrValue }}"{% endfor %}>
{%- endset -%}
{%- if params.prefix or params.suffix %}
  <div class="nhsw-input-wrapper">
{%- if params.prefix %}
    <div class="nhsw-input-wrapper__prefix" aria-hidden="true">{{ params.prefix.html | safe if params.prefix.html else params.prefix.text }}</div>
{%- endif %}
    {{ inputEl | safe }}
{%- if params.suffix %}
    <div class="nhsw-input-wrapper__suffix" aria-hidden="true">{{ params.suffix.html | safe if params.suffix.html else params.suffix.text }}</div>
{%- endif %}
  </div>
{%- else %}
  {{ inputEl | safe }}
{%- endif %}
{%- if hasCharacterCount %}
  {{ nhswHint({ text: params.characterCountMessage or ("You have " ~ params.maxlength ~ " characters remaining"), id: countId }) }}
{%- endif %}
</div>
{%- endmacro -%}

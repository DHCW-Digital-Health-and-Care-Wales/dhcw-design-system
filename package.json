{
  "name": "nhsw-style-library",
  "version": "0.1.22",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-preview-site.js && playwright test",
    "build:preview": "node scripts/build-preview-site.js",
    "build:css": "sass src/index.scss preview/dist/nhsw.css && sass src/index.scss preview/dist/nhsw.min.css --style=compressed --no-source-map",
    "postbuild:css": "node -e \"const f=require('fs');f.mkdirSync('preview/dist',{recursive:true});f.copyFileSync('dist/nhsw-date-picker.js','preview/dist/nhsw-date-picker.js');f.copyFileSync('dist/nhsw-behaviours.js','preview/dist/nhsw-behaviours.js');\"",
    "watch:css": "sass --watch src/index.scss:preview/dist/nhsw.css",
    "build:js": "esbuild dist/nhsw-behaviours.js --minify --outfile=dist/nhsw-behaviours.min.js && esbuild dist/nhsw-date-picker.js --minify --outfile=dist/nhsw-date-picker.min.js",
    "postbuild:js": "node -e \"const f=require('fs');f.mkdirSync('preview/dist',{recursive:true});f.copyFileSync('dist/nhsw-behaviours.min.js','preview/dist/nhsw-behaviours.min.js');f.copyFileSync('dist/nhsw-date-picker.min.js','preview/dist/nhsw-date-picker.min.js');\"",
    "render:njk": "node scripts/render-njk-examples.js",
    "package:njk": "node scripts/package-njk-components.js",
    "sync:gptr": "node -e \"const f=require('fs');const dist='dist';const targets=['../../../source/repos/GPTR/src/Presentation/Web/GPTR','../../../source/repos/GPTR/src/Presentation/Web/GPTR.Maintenance','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR.Maintenance'];targets.forEach(t=>{f.mkdirSync(t+'/Content/nhsw',{recursive:true});f.mkdirSync(t+'/Scripts/nhsw',{recursive:true});f.copyFileSync(dist+'/nhsw.css',t+'/Content/nhsw/nhsw.css');f.copyFileSync(dist+'/nhsw.css.map',t+'/Content/nhsw/nhsw.css.map');f.copyFileSync(dist+'/nhsw-date-picker.js',t+'/Scripts/nhsw/nhsw-date-picker.js');f.copyFileSync(dist+'/nhsw-behaviours.js',t+'/Scripts/nhsw/nhsw-behaviours.js');console.log('Synced to '+t);});\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "jsdom": "^29.1.1",
    "liquidjs": "^10.29.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.62.1",
    "sass": "^1.93.2",
    "vitest": "^4.1.10"
  }
}

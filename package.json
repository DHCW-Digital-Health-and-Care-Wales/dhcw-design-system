{
  "name": "dhcw-design-system",
  "version": "0.1.70",
  "description": "Digital Health and Care Wales design system: Sass styles, JavaScript behaviours and Nunjucks components.",
  "keywords": [
    "design-system",
    "nhs",
    "nhs-wales",
    "dhcw",
    "sass",
    "nunjucks",
    "accessibility"
  ],
  "homepage": "https://dhcw-digital-health-and-care-wales.github.io/dhcw-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DHCW-Digital-Health-and-Care-Wales/dhcw-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/DHCW-Digital-Health-and-Care-Wales/dhcw-design-system/issues"
  },
  "license": "MIT",
  "files": [
    "src",
    "dist/nhsw.css",
    "dist/nhsw.css.map",
    "dist/nhsw.min.css",
    "dist/nhsw-behaviours.js",
    "dist/nhsw-behaviours.min.js",
    "dist/nhsw-date-picker.js",
    "dist/nhsw-date-picker.min.js",
    "LICENSE",
    "LICENSE-CONTENT.md",
    "README.md"
  ],
  "style": "dist/nhsw.min.css",
  "sass": "src/index.scss",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-preview-site.js && playwright test",
    "build:preview": "node scripts/build-preview-site.js",
    "build:search": "node scripts/build-search-index.js",
    "build:css": "sass src/index.scss preview/dist/nhsw.css && sass src/index.scss preview/dist/nhsw.min.css --style=compressed --no-source-map",
    "postbuild:css": "node -e \"const f=require('fs');f.mkdirSync('preview/dist',{recursive:true});f.copyFileSync('dist/nhsw-date-picker.js','preview/dist/nhsw-date-picker.js');f.copyFileSync('dist/nhsw-behaviours.js','preview/dist/nhsw-behaviours.js');\" && node scripts/build-search-index.js",
    "watch:css": "sass --watch src/index.scss:preview/dist/nhsw.css",
    "build:js": "esbuild dist/nhsw-behaviours.js --minify --outfile=dist/nhsw-behaviours.min.js && esbuild dist/nhsw-date-picker.js --minify --outfile=dist/nhsw-date-picker.min.js",
    "postbuild:js": "node -e \"const f=require('fs');f.mkdirSync('preview/dist',{recursive:true});f.copyFileSync('dist/nhsw-behaviours.min.js','preview/dist/nhsw-behaviours.min.js');f.copyFileSync('dist/nhsw-date-picker.min.js','preview/dist/nhsw-date-picker.min.js');\"",
    "render:njk": "node scripts/render-njk-examples.js",
    "package:njk": "node scripts/package-njk-components.js",
    "sync:gptr": "node -e \"const f=require('fs');const dist='dist';const targets=['../../../source/repos/GPTR/src/Presentation/Web/GPTR','../../../source/repos/GPTR/src/Presentation/Web/GPTR.Maintenance','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR','../../../source/repos/GPTR_Dev_Wcp_Integration/NWIS.GPTR/Presentation/Web/GPTR.Maintenance'];targets.forEach(t=>{f.mkdirSync(t+'/Content/nhsw',{recursive:true});f.mkdirSync(t+'/Scripts/nhsw',{recursive:true});f.copyFileSync(dist+'/nhsw.css',t+'/Content/nhsw/nhsw.css');f.copyFileSync(dist+'/nhsw.css.map',t+'/Content/nhsw/nhsw.css.map');f.copyFileSync(dist+'/nhsw-date-picker.js',t+'/Scripts/nhsw/nhsw-date-picker.js');f.copyFileSync(dist+'/nhsw-behaviours.js',t+'/Scripts/nhsw/nhsw-behaviours.js');console.log('Synced to '+t);});\"",
    "build:npm": "npm run build:css && npm run build:js && node scripts/prepare-npm-package.js",
    "report:tests": "node scripts/generate-test-report.js",
    "report:tests:reuse": "node scripts/generate-test-report.js --reuse",
    "pack:check": "npm run build:npm && npm pack --dry-run",
    "prepublishOnly": "node scripts/prepare-npm-package.js --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "jsdom": "^29.1.1",
    "liquidjs": "^10.29.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.62.1",
    "sass": "^1.93.2",
    "vitest": "^4.1.10"
  }
}
